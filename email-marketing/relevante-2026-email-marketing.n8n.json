    {
      "name": "Filtrar pendentes + limite diário",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        20
      ],
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst contatos = $('Contatos').all().map(i => i.json).filter(c => c.email && String(c.email).includes('@'));\nconst enviados = new Set($('Já enviados').all().map(i => String(i.json.email || '').trim().toLowerCase()).filter(Boolean));\n\nconst pendentes = contatos.filter(c => !enviados.has(String(c.email).trim().toLowerCase()));\nconst lote = pendentes.slice(0, Number(cfg.limiteDiario) || 400);\n\nfunction primeiroNome(nome) {\n  const n = String(nome || '').trim().split(/\\s+/)[0] || '';\n  if (!n) return 'jovem';\n  const low = n.toLowerCase();\n  if (['pr.', 'pra.', 'pr', 'pra', 'pastor', 'pastora'].includes(low)) {\n    const s = String(nome).trim().split(/\\s+/)[1] || n;\n    return s.charAt(0).toUpperCase() + s.slice(1).toLowerCase();\n  }\n  return n.charAt(0).toUpperCase() + n.slice(1).toLowerCase();\n}\n\nreturn lote.map(c => {\n  const id = String(c.id || '').trim();\n  const pn = primeiroNome(c.nome);\n  const linkSite = `${cfg.webhookBase}?c=${encodeURIComponent(id)}&d=site`;\n  const linkValores = `${cfg.webhookBase}?c=${encodeURIComponent(id)}&d=valores`;\n  return { json: {\n    id, nome: c.nome, email: String(c.email).trim(), primeiro_nome: pn,\n    assunto: String(cfg.assunto).replace(/{{PRIMEIRO_NOME}}/g, pn),\n    link_site: linkSite, link_valores: linkValores,\n    total_pendentes: pendentes.length, enviando_agora: lote.length,\n  }};\n});"
      },
      "id": "8066632a-b830-4e7c-880b-29ab34a0dfdc"
    },
