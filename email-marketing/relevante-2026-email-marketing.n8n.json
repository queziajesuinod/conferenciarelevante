    {
      "name": "Montar e-mail (HTML)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        40
      ],
      "parameters": {
        "jsCode": "const tpl = \"<!DOCTYPE html>\\n<html lang=\\\"pt-BR\\\">\\n<head>\\n<meta charset=\\\"UTF-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n<title>Conferência Relevante 2026 · ALEGRIA</title>\\n<style>\\n  body{margin:0;padding:0;background:#0C1C32;-webkit-text-size-adjust:100%;}\\n  table{border-collapse:collapse;}\\n  img{border:0;display:block;}\\n  a{color:#d4ff1a;}\\n  .btn:hover{background:#e6ff4d !important;}\\n  @media only screen and (max-width:620px){\\n    .wrap{width:100% !important;}\\n    .px{padding-left:20px !important;padding-right:20px !important;}\\n    .h1{font-size:26px !important;line-height:30px !important;}\\n    .stack{display:block !important;width:100% !important;}\\n  }\\n</style>\\n</head>\\n<body style=\\\"margin:0;padding:0;background:#0C1C32;\\\">\\n<div style=\\\"display:none;max-height:0;overflow:hidden;font-size:1px;line-height:1px;color:#0C1C32;\\\">{{PRIMEIRO_NOME}}, o lote 01 vai até 01/10. Garanta seu lugar na Relevante 2026 · ALEGRIA. 15, 16 e 17 de outubro.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div>\\n<table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"background:#0C1C32;\\\">\\n<tr><td align=\\\"center\\\" style=\\\"padding:28px 12px;\\\">\\n<table role=\\\"presentation\\\" class=\\\"wrap\\\" width=\\\"600\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"width:600px;max-width:600px;\\\">\\n\\n  <!-- Topo: logo juventude -->\\n  <tr><td align=\\\"center\\\" style=\\\"padding:0 0 18px 0;\\\">\\n    <img src=\\\"https://juventuderelevante.com.br/logos/logojuventudebranca-8.png\\\" width=\\\"110\\\" alt=\\\"Juventude Relevante\\\" style=\\\"width:110px;height:auto;margin:0 auto;\\\">\\n  </td></tr>\\n\\n  <!-- Hero -->\\n  <tr><td style=\\\"background:#081525;background-image:radial-gradient(ellipse at 50% 0%,#14315e 0%,#081525 60%);border:1px solid #213a63;border-radius:14px;\\\">\\n    <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\">\\n      <tr><td align=\\\"center\\\" style=\\\"padding:26px 24px 6px 24px;\\\">\\n        <table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr>\\n          <td style=\\\"border:2px solid #d4ff1a;border-radius:999px;padding:7px 18px;font-family:'Baron Neue','Arial Black',Arial,sans-serif;font-size:13px;letter-spacing:2px;color:#d4ff1a;font-weight:700;\\\">15 | 16 | 17 DE OUTUBRO DE 2026</td>\\n        </tr></table>\\n      </td></tr>\\n      <tr><td align=\\\"center\\\" class=\\\"px\\\" style=\\\"padding:14px 34px 0 34px;\\\">\\n        <img src=\\\"https://juventuderelevante.com.br/logos/logo%20conferencia%202026.png\\\" width=\\\"520\\\" alt=\\\"Conferência Relevante 2026\\\" style=\\\"width:100%;max-width:520px;height:auto;margin:0 auto;\\\">\\n      </td></tr>\\n      <tr><td align=\\\"center\\\" style=\\\"padding:10px 24px 0 24px;\\\">\\n        <img src=\\\"https://juventuderelevante.com.br/logos/logo%20alegria.png\\\" width=\\\"210\\\" alt=\\\"ALEGRIA\\\" style=\\\"width:210px;height:auto;margin:0 auto;\\\">\\n      </td></tr>\\n      <tr><td align=\\\"center\\\" class=\\\"px\\\" style=\\\"padding:22px 40px 30px 40px;font-family:Georgia,'Times New Roman',serif;font-style:italic;font-size:15px;line-height:23px;color:#9fb6de;\\\">\\n        “Tenho-vos dito estas coisas para que a minha alegria esteja em vós, e a vossa alegria seja completa.”<br><span style=\\\"font-style:normal;font-family:Arial,sans-serif;font-size:12px;letter-spacing:1px;color:#d4ff1a;\\\">JOÃO 15:11</span>\\n      </td></tr>\\n    </table>\\n  </td></tr>\\n\\n  <!-- Texto -->\\n  <tr><td class=\\\"px\\\" style=\\\"padding:34px 36px 8px 36px;font-family:Arial,Helvetica,sans-serif;color:#D6E6FC;\\\">\\n    <p class=\\\"h1\\\" style=\\\"margin:0 0 14px 0;font-family:'Baron Neue','Arial Black',Arial,sans-serif;font-size:30px;line-height:34px;font-weight:900;color:#ffffff;\\\">Oi, {{PRIMEIRO_NOME}}! A Relevante está de volta.</p>\\n    <p style=\\\"margin:0 0 14px 0;font-size:16px;line-height:26px;\\\">Você viveu a Conferência Relevante em 2025 com a gente, e a gente quer você de novo. Em 2026 chegamos à <strong style=\\\"color:#ffffff;\\\">8ª edição</strong>, e o tema é <strong style=\\\"color:#d4ff1a;\\\">ALEGRIA</strong>: três dias de adoração e palavra com fundamento, com mais de mil jovens reunidos na IECG.</p>\\n    <p style=\\\"margin:0 0 14px 0;font-size:16px;line-height:26px;\\\">Quatro sessões nos dias <strong style=\\\"color:#ffffff;\\\">15, 16 e 17 de outubro</strong>, e o ingresso único dá acesso aos três dias.</p>\\n  </td></tr>\\n\\n  <!-- Line-up -->\\n  <tr><td class=\\\"px\\\" style=\\\"padding:12px 36px 0 36px;\\\">\\n    <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"background:#15294a;border-radius:12px;\\\">\\n      <tr><td style=\\\"padding:20px 22px 18px 22px;font-family:Arial,Helvetica,sans-serif;\\\">\\n        <p style=\\\"margin:0 0 8px 0;font-size:11px;letter-spacing:2px;color:#d4ff1a;font-weight:700;\\\">LINE-UP CONFIRMADO</p>\\n        <p style=\\\"margin:0;font-size:15px;line-height:25px;color:#ffffff;\\\">Apóstolo Edmilson · Pastor Aldo Giovanni · Pastora Rebeca · Bispo Teo Hayashi · Pastor Davi Lago · Preletor John Dias · Pastor Felippe Valadão</p>\\n      </td></tr>\\n    </table>\\n  </td></tr>\\n\\n  <!-- Lote -->\\n  <tr><td class=\\\"px\\\" style=\\\"padding:16px 36px 0 36px;\\\">\\n    <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"border:1px solid #d4ff1a;border-radius:12px;\\\">\\n      <tr><td style=\\\"padding:18px 22px;font-family:Arial,Helvetica,sans-serif;\\\">\\n        <p style=\\\"margin:0 0 6px 0;font-size:11px;letter-spacing:2px;color:#d4ff1a;font-weight:700;\\\">LOTE 01 · SÓ ATÉ 01/10</p>\\n        <p style=\\\"margin:0 0 4px 0;font-size:15px;line-height:24px;color:#D6E6FC;\\\">Frente <strong style=\\\"color:#ffffff;\\\">R$ 250</strong> &nbsp;·&nbsp; Intermediário <strong style=\\\"color:#ffffff;\\\">R$ 180</strong> &nbsp;·&nbsp; Galeria <strong style=\\\"color:#ffffff;\\\">R$ 160</strong></p>\\n        <p style=\\\"margin:0;font-size:13px;line-height:20px;color:#9fb6de;\\\">A partir de 02/10 entra o lote 02 e os valores sobem. Quem foi em 2025 sabe: os melhores setores acabam primeiro.</p>\\n      </td></tr>\\n    </table>\\n  </td></tr>\\n\\n  <!-- CTA -->\\n  <tr><td align=\\\"center\\\" style=\\\"padding:30px 36px 12px 36px;\\\">\\n    <table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr>\\n      <td class=\\\"btn\\\" align=\\\"center\\\" style=\\\"background:#d4ff1a;border-radius:8px;box-shadow:0 0 30px rgba(212,255,26,.35);\\\">\\n        <a href=\\\"{{LINK_SITE}}\\\" style=\\\"display:inline-block;padding:18px 40px;font-family:'Baron Neue','Arial Black',Arial,sans-serif;font-size:16px;letter-spacing:2px;font-weight:900;color:#0C1C32;text-decoration:none;\\\">GARANTIR MEU INGRESSO</a>\\n      </td>\\n    </tr></table>\\n    <p style=\\\"margin:14px 0 0 0;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:20px;color:#9fb6de;\\\">ou <a href=\\\"{{LINK_VALORES}}\\\" style=\\\"color:#d4ff1a;text-decoration:underline;\\\">veja todos os setores, valores e lotes</a></p>\\n  </td></tr>\\n\\n  <!-- Local -->\\n  <tr><td class=\\\"px\\\" style=\\\"padding:22px 36px 30px 36px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#9fb6de;border-bottom:1px solid #213a63;\\\">\\n    <strong style=\\\"color:#D6E6FC;\\\">Onde:</strong> IECG · Igreja Evangélica Comunidade Global<br>Rua Treze de Maio, 1240 · Campo Grande, MS\\n  </td></tr>\\n\\n  <!-- Rodapé -->\\n  <tr><td align=\\\"center\\\" style=\\\"padding:22px 36px 0 36px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:19px;color:#6b7ba3;\\\">\\n    Você está recebendo este e-mail porque participou da Conferência Relevante 2025.<br>\\n    <a href=\\\"https://www.instagram.com/juventuderelevanteiecg/\\\" style=\\\"color:#9fb6de;text-decoration:none;\\\">@juventuderelevanteiecg</a> &nbsp;·&nbsp; <a href=\\\"https://juventuderelevante.com.br/\\\" style=\\\"color:#9fb6de;text-decoration:none;\\\">juventuderelevante.com.br</a><br>\\n    Não quer mais receber novidades da Conferência? <a href=\\\"mailto:{{REMETENTE}}?subject=SAIR&body=Quero%20sair%20da%20lista%20da%20Confer%C3%AAncia%20Relevante.\\\" style=\\\"color:#9fb6de;\\\">Responda com SAIR</a>.\\n  </td></tr>\\n\\n</table>\\n</td></tr>\\n</table>\\n</body>\\n</html>\\n\";\nconst cfg = $('Config').first().json;\nconst c = $input.first().json;\nconst htmlFinal = tpl\n  .replace(/{{PRIMEIRO_NOME}}/g, c.primeiro_nome)\n  .replace(/{{LINK_SITE}}/g, c.link_site)\n  .replace(/{{LINK_VALORES}}/g, c.link_valores)\n  .replace(/{{REMETENTE}}/g, cfg.remetenteEmail);\nreturn [{ json: { ...c, html: htmlFinal } }];"
      },
      "id": "b7fba887-84e5-4cea-bee7-761117fcdde6"
    },
